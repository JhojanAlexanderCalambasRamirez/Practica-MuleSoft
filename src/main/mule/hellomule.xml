<?xml version="1.0" encoding="UTF-8"?>

<mule xmlns:http="http://www.mulesoft.org/schema/mule/http" xmlns="http://www.mulesoft.org/schema/mule/core"
	xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
http://www.mulesoft.org/schema/mule/http http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd">
	<configuration-properties doc:name="Configuration properties" file="config-dev.yaml" />
	<http:listener-config name="HTTP_Listener_config" doc:name="HTTP Listener config" doc:id="ed5e7e0c-b0fb-4a50-b9ef-45baf3b8a6c6" basePath="/hello" >
		<http:listener-connection host="0.0.0.0" port="${http.port}" />
	</http:listener-config>
	<http:request-config name="JsonPlaceholder_Request_config" doc:name="HTTP Request configuration" >
		<http:request-connection protocol="HTTPS" host="${users.api.host}" port="${users.api.port}" />
	</http:request-config>
	<flow name="hellomuleFlow" doc:id="3885aa2d-4fbb-4a12-b1a5-bf657b7f695a" >
		<http:listener doc:name="Listener" doc:id="2df21f70-f7ea-40ad-8507-cfffa5e3b94f" config-ref="HTTP_Listener_config" path="/"/>
		<logger level="INFO" doc:name="Logger" message="#['Request recibido. Query params: ' ++ write(attributes.queryParams, 'application/json')]" />
		<set-variable variableName="saludo" value="#[if (now().hour &lt; 12) 'Buenos días' else if (now().hour &lt; 19) 'Buenas tardes' else 'Buenas noches']" doc:name="Set saludo" />
		<set-payload value='#[%dw 2.0
output application/json
---
{
	saludo: vars.saludo,
	message: "Hello " ++ (attributes.queryParams.nombre default "World")
}]' doc:name="Set Payload" doc:id="cca62be8-dacc-4e9f-a44c-6fc2b4087511" mimeType="application/json" />
	</flow>
	<flow name="usersFlow" doc:id="a1b2c3d4-1111-4a4a-8a8a-000000000001" >
		<http:listener doc:name="Listener" doc:id="a1b2c3d4-1111-4a4a-8a8a-000000000002" config-ref="HTTP_Listener_config" path="/users">
			<http:response statusCode="#[vars.httpStatus default 200]" />
			<http:error-response statusCode="#[vars.httpStatus default 500]" />
		</http:listener>
		<try doc:name="Try" doc:id="a1b2c3d4-1111-4a4a-8a8a-000000000003">
			<http:request method="GET" doc:name="GET externos /users" doc:id="a1b2c3d4-1111-4a4a-8a8a-000000000004" config-ref="JsonPlaceholder_Request_config" path="/users" />
			<set-payload value='#[%dw 2.0
output application/json
---
payload map (user) -> {
	id: user.id,
	nombre: user.name,
	email: user.email,
	ciudad: user.address.city
}]' doc:name="Transformar usuarios" doc:id="a1b2c3d4-1111-4a4a-8a8a-000000000005" mimeType="application/json" />
			<error-handler>
				<on-error-continue type="ANY" doc:name="Error controlado" doc:id="a1b2c3d4-1111-4a4a-8a8a-000000000006">
					<set-variable variableName="httpStatus" value="#[502]" doc:name="Set 502" />
					<set-payload value='#[%dw 2.0
output application/json
---
{
	error: true,
	mensaje: "No se pudo obtener la lista de usuarios",
	detalle: error.description
}]' doc:name="Error payload" mimeType="application/json" />
				</on-error-continue>
			</error-handler>
		</try>
	</flow>
	<flow name="statusFlow" doc:id="a1b2c3d4-1111-4a4a-8a8a-000000000007" >
		<http:listener doc:name="Listener" doc:id="a1b2c3d4-1111-4a4a-8a8a-000000000008" config-ref="HTTP_Listener_config" path="/status"/>
		<set-payload value='#[%dw 2.0
output application/json
---
{
	status: "UP",
	app: "hellomule",
	timestamp: now()
}]' doc:name="Set Payload" doc:id="a1b2c3d4-1111-4a4a-8a8a-000000000009" mimeType="application/json" />
	</flow>
</mule>
